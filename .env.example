# Server only. Never prefix credentials with NEXT_PUBLIC_.
CAMERA_RTSP_URL=
# Preferred configured source: MediaMTX RTSP read URL (best for H.265 + low latency).
# Example: rtsp://mediamtx-host:8554/your-path
# HLS also works (higher latency): https://host/path/index.m3u8
# Do not set a WHEP URL here — WHEP is native WebRTC and cannot guarantee H.265 in all browsers.
MEDIAMTX_STREAM_URL=
FFMPEG_PATH=ffmpeg

# Local multi-service URLs (browser must reach these on the host)
# Backend defaults to 3101 so it does not collide with other apps on :3001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_STREAM_URL=http://127.0.0.1:3002
STREAMING_URL=http://127.0.0.1:3002
STREAM_PUBLIC_URL=http://127.0.0.1:3002
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
# Any loopback origin is accepted unless NODE_ENV=production, so a dev server that moves
# to another port still works. Set to false to enforce ALLOWED_ORIGINS strictly.
ALLOW_LOOPBACK_ORIGINS=
# Max concurrent HTTP viewers (many can share one FFmpeg for the same URL)
STREAM_MAX_CONNECTIONS=64
# Max unique camera remuxes (1 FFmpeg per distinct RTSP/HLS URL)
STREAM_MAX_SOURCES=64
# Stop a shared FFmpeg after the last viewer leaves (ms)
STREAM_SOURCE_IDLE_MS=15000
# Fail a source that produces no bytes during startup or playback (ms).
# Keep this above the camera's keyframe interval and input analysis time.
STREAM_SOURCE_TIMEOUT_MS=30000
# Maximum buffered MPEG-TS bytes per viewer; disconnect viewers that fall behind.
STREAM_VIEWER_QUEUE_BYTES=1048576
BACKEND_PORT=3101
STREAMING_PORT=3002
FRONTEND_PORT=3000
